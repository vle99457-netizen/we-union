{
  "name": "we-union",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "audit:source": "node scripts/source-audit.mjs",
    "smoke:routes": "node scripts/route-smoke.mjs",
    "preview:capture": "node scripts/capture-page-previews.mjs",
    "preview:verify": "node scripts/verify-page-previews.mjs",
    "e2e": "node scripts/e2e-site.mjs",
    "verify": "npm run check && npm test && npm run audit:source && npm run smoke:routes && npm run e2e && npm run build && npm run preview:verify"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "puppeteer-core": "^25.6.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
